{
  "expo": {
    "name": "Sub2API Mate",
    "slug": "sub2api-mate",
    "owner": "dude1wudv",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.ppx.sub2apimate",
      "buildNumber": "10",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/icon.png",
      "package": "com.ppx.sub2apimate",
      "versionCode": 10,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#2F6DF6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/with-release-signing",
      "./plugins/with-honor-widget-compatibility",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Sub2ApiDashboard",
              "label": "Sub2API 看板",
              "description": "查看请求、Token、成本和异常账号",
              "minWidth": "250dp",
              "minHeight": "160dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {},
      "appRepository": "dude1wudv/sub2api-mate",
      "appAuthor": "dude1wudv",
      "updateSource": "github-releases"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "scheme": "sub2apimobile",
    "updates": {
      "enabled": false
    }
  }
}
